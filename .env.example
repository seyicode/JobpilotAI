# Local development only. Copy to .env; never commit .env.
# Database credentials: change these for any shared environment.
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot_local_only
POSTGRES_DB=jobpilot
# Host ports; services bind to localhost through Compose.
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
# Native API connection. Compose constructs its own URL using host db.
# URL-encode special characters if you change credentials.
DATABASE_URL=postgresql://jobpilot:jobpilot_local_only@localhost:5432/jobpilot
# Browser origins allowed to call the API (JSON array).
CORS_ORIGINS=["http://localhost:3000"]
# Browser-visible API URL, never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Largest resume upload the API accepts, in bytes (default 5 MB).
MAX_RESUME_BYTES=5242880

# --- AI requirement extraction (optional, paid) ---
# Leave the key or model blank to use only the free local rules. The key is read by the API
# container only; never put it in a NEXT_PUBLIC_* variable.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Request limits.
# AI_TIMEOUT_SECONDS=20
# AI_MAX_RETRIES=2
# AI_MAX_INPUT_CHARS=20000
# AI_MAX_OUTPUT_TOKENS=1500
# Spending controls, checked before every request. Look up your model's current prices.
# AI_DAILY_REQUEST_LIMIT=50
# AI_MONTHLY_TOKEN_LIMIT=1000000
# AI_MONTHLY_BUDGET_USD=5
# AI_INPUT_COST_PER_MILLION_TOKENS_USD=
# AI_OUTPUT_COST_PER_MILLION_TOKENS_USD=
